diff --git a/cmake/FindDependencies.cmake b/cmake/FindDependencies.cmake
index e26d5e9..5fbe458 100644
--- a/cmake/FindDependencies.cmake
+++ b/cmake/FindDependencies.cmake
@@ -226,16 +226,19 @@ if(DOWNLOAD_ENABLED)
     # and curl[openssl] otherwise.
     find_package(CURL QUIET)
     set(CRYPTO_FOUND FALSE)
-    if(IS_MSVC AND IS_ARM64)
+    if(COLMAP_USE_CRYPTOPP OR
+       (NOT DEFINED COLMAP_USE_CRYPTOPP AND IS_MSVC AND IS_ARM64))
         # OpenSSL crashes for ARM64 under Windows. We therefore fall back to
         # CryptoPP as an alternative to OpenSSL for SHA256 computation.
-        find_package(CryptoPP QUIET)
+        find_package(CryptoPP CONFIG QUIET)
         if(CryptoPP_FOUND)
+            set(COLMAP_USE_CRYPTOPP ON)
             set(CRYPTO_FOUND TRUE)
         else()
             message(STATUS "CryptoPP not found")
         endif()
     else()
+        set(COLMAP_USE_CRYPTOPP OFF)
         find_package(OpenSSL QUIET COMPONENTS Crypto)
         if(OpenSSL_FOUND)
             set(CRYPTO_FOUND TRUE)
