function(spirv_pc_collect_dependency item)
    if(item MATCHES "^\\$<LINK_ONLY:([^<>]+)>$")
        set(item "${CMAKE_MATCH_1}")
    endif()

    if(item MATCHES "^ZLIB::ZLIB(STATIC)?$")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_requires zlib)
    elseif(item MATCHES "^zstd::libzstd_(static|shared)$")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_requires libzstd)
    elseif(item STREQUAL "FFI::ffi")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_requires libffi)
    elseif(item MATCHES "^LibXml2::LibXml2(Static)?$")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_requires libxml-2.0)
    elseif(item STREQUAL "DIASDK::Diaguids")
        # The translator does not use LLVM's DIA-specific APIs.
    elseif(TARGET "${item}")
        get_property(active GLOBAL PROPERTY spirv_pc_active)
        if(item IN_LIST active)
            message(FATAL_ERROR "Cyclic LLVM dependency while generating LLVMSPIRVLib.pc: ${active};${item}")
        endif()
        get_property(visited GLOBAL PROPERTY spirv_pc_visited)
        if(item IN_LIST visited)
            return()
        endif()
        set_property(GLOBAL APPEND PROPERTY spirv_pc_active "${item}")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_visited "${item}")

        get_target_property(links "${item}" INTERFACE_LINK_LIBRARIES)
        if(links)
            # LLVM's MSVC delay-load flags only affect process startup and are
            # not portable through pkg-config's MSVC syntax.
            string(REGEX REPLACE
                [[\$<\$<NOT:\$<LINK_LANGUAGE:Swift>>:delayimp;[^;]*-delayload:shell32\.dll;[^;]*-delayload:ole32\.dll>]]
                "" links "${links}")
            foreach(link IN LISTS links)
                if(NOT link STREQUAL "")
                    spirv_pc_collect_dependency("${link}")
                endif()
            endforeach()
        endif()

        get_target_property(type "${item}" TYPE)
        if(NOT type STREQUAL "INTERFACE_LIBRARY")
            if(NOT item MATCHES "^LLVM")
                message(FATAL_ERROR "Unsupported target dependency for LLVMSPIRVLib.pc: ${item}")
            endif()
            set_property(GLOBAL APPEND PROPERTY spirv_pc_targets "${item}")
        endif()

        get_property(active GLOBAL PROPERTY spirv_pc_active)
        list(POP_BACK active)
        set_property(GLOBAL PROPERTY spirv_pc_active "${active}")
    elseif(item MATCHES "^-L" OR item MATCHES "[/\\\\ \t]")
        message(FATAL_ERROR "Non-relocatable dependency for LLVMSPIRVLib.pc: ${item}")
    elseif(item MATCHES "^-")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_flags "${item}")
    elseif(item MATCHES "^[A-Za-z0-9_+.-]+$")
        string(REGEX REPLACE "\\.lib$" "" item "${item}")
        set_property(GLOBAL APPEND PROPERTY spirv_pc_flags "-l${item}")
    else()
        message(FATAL_ERROR "Unsupported dependency for LLVMSPIRVLib.pc: ${item}")
    endif()
endfunction()

function(spirv_pc_generate_dependencies)
    get_target_property(links LLVMSPIRVLib INTERFACE_LINK_LIBRARIES)
    foreach(link IN LISTS links)
        spirv_pc_collect_dependency("${link}")
    endforeach()

    get_property(targets GLOBAL PROPERTY spirv_pc_targets)
    get_property(flags GLOBAL PROPERTY spirv_pc_flags)
    get_property(requires GLOBAL PROPERTY spirv_pc_requires)
    list(REVERSE targets)
    list(REMOVE_DUPLICATES flags)
    list(REMOVE_DUPLICATES requires)

    set(libs "")
    foreach(target IN LISTS targets)
        string(APPEND libs " -l$<TARGET_LINKER_FILE_BASE_NAME:${target}>")
    endforeach()
    foreach(flag IN LISTS flags)
        string(APPEND libs " ${flag}")
    endforeach()

    file(READ "${CMAKE_BINARY_DIR}/LLVMSPIRVLib.pc" contents)
    string(APPEND contents "Libs.private:${libs}\n")
    if(requires)
        list(JOIN requires " " requires)
        string(APPEND contents "Requires.private: ${requires}\n")
    endif()
    file(GENERATE
        OUTPUT "${CMAKE_BINARY_DIR}/LLVMSPIRVLib.pc"
        CONTENT "${contents}"
        CONDITION "$<CONFIG:${CMAKE_BUILD_TYPE}>"
    )
endfunction()

cmake_language(DEFER CALL spirv_pc_generate_dependencies)
