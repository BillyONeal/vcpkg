{
  "name": "knewstuff",
  "version": "6.31.0",
  "description": "Framework for downloading and sharing additional application data (Core API only; QML and Widgets integrations are not packaged)",
  "homepage": "https://invent.kde.org/frameworks/knewstuff",
  "documentation": "https://api.kde.org/knewstuff-index.html",
  "license": "LGPL-2.1-or-later AND (LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL)",
  "dependencies": [
    "attica",
    "ecm",
    {
      "name": "gettext",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "karchive",
    "kconfig",
    "kcoreaddons",
    "ki18n",
    "kpackage",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "gui",
        "network"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "translations": {
      "description": "Build and install translation files"
    }
  }
}
